[
  {
    "bindings": {
      // zed
      "cmd-<": "zed::OpenSettingsFile",
      "cmd-shift-k": "zed::OpenKeymapFile",

      // panels
      "cmd-e": "project_panel::Toggle",
      "cmd-g": "git_panel::Toggle",

      // pane
      "ctrl-tab": ["pane::ActivateNextItem", { "wrap_around": false }],
      "ctrl-shift-tab": ["pane::ActivatePreviousItem", { "wrap_around": false }],
      "cmd-r": "pane::RevealInProjectPanel",
      "cmd-1": ["pane::ActivateItem", 0],
      "cmd-2": ["pane::ActivateItem", 1],
      "cmd-3": ["pane::ActivateItem", 2],
      "cmd-4": ["pane::ActivateItem", 3],
      "cmd-\\": "pane::AlternateFile",

      // editing
      "cmd-shift-c": "editor::ToggleComments",
      "cmd-shift-s": "workspace::SaveWithoutFormat",
      "alt-z": "editor::ToggleSoftWrap",

      // terminal
      "cmd-t": "workspace::NewCenterTerminal",
      "alt-t": ["task::Spawn", { "task_name": "terminal: new terminal at file dir" }],
    },
  },
  {
    "context": "FileFinder > Picker > Editor",
    "bindings": {
      "tab": "picker::TogglePreview",
    },
  },
  {
    // pane::ActivateItem needs pane focus, so focus the first pane before replaying cmd-1.
    "context": "ProjectPanel || GitPanel",
    "bindings": {
      "cmd-1": [
        "action::Sequence",
        [
          ["workspace::ActivatePane", 0],
          ["workspace::SendKeystrokes", "cmd-1"],
        ],
      ],
    },
  },
]
